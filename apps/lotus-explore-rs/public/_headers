# Netlify / Cloudflare Pages / compatible CDN — HTTP security & cache headers

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-o1bjP+VSHvcOzdkXHTYrHnMcZabetghZcgiacGCFMM0=' https://scripts.simpleanalyticscdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://qlever.dev https://query.wikidata.org https://query-scholarly.wikidata.org https://www.wikidata.org https://www.simolecule.com https://idsm.elixir-czech.cz https://doi.org https://pubchem.ncbi.nlm.nih.gov https://api.semanticscholar.org https://api.openalex.org; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types default
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin
  Link: </llms.txt>; rel="http://llmstxt.org/llms.txt"; type="text/plain"
  Link: </.well-known/agent-skills.json>; rel="https://specification.website/rel/agent-skills"; type="application/json"
  Link: </.well-known/api-catalog.json>; rel="https://specification.website/rel/api-catalog"; type="application/json"
  Link: </.well-known/ai-catalog.json>; rel="ai-catalog"; type="application/json"
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"
  Link: </robots.txt>; rel="robots"; type="text/plain"
  Link: </.well-known/security.txt>; rel="security.txt"; type="text/plain"


# Ketcher editor iframe (served from /assets/ketcher/): allow same-origin framing.
# The wildcard /* rule above sets X-Frame-Options: DENY + frame-ancestors 'none',
# which would block the iframe — this more-specific rule overrides both.
/assets/ketcher/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'self'; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; font-src 'self' data:; object-src 'none'

# Cache rules for Metadata & Manifest (Must revalidate to deliver updates immediately)
/.well-known/*
  Cache-Control: no-cache, must-revalidate

/robots.txt
  Cache-Control: no-cache, must-revalidate

/sitemap.xml
  Cache-Control: no-cache, must-revalidate

/llms.txt
  Cache-Control: no-cache, must-revalidate

/site.webmanifest
  Cache-Control: no-cache, must-revalidate

/humans.txt
  Cache-Control: no-cache, must-revalidate

# Favicons & Icons
/favicon*
  Cache-Control: no-cache, must-revalidate

/*icon*.png
  Cache-Control: no-cache, must-revalidate

# Heavy immutable binary assets
/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/wasm/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed bundles (JS glue, wasm) are safe to pin for a year.
    /**/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed assets keep their filenames across deploys, so they must
# revalidate: an immutable year-long entry would pin users to a stale
# stylesheet or bridge script until they hard-reload.
    /assets/lotus-explore.css
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/vendor/*
  Cache-Control: no-cache, must-revalidate

/index.html
  No-Vary-Search: key-order, params, except=("locale")
