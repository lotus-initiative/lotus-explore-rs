# Single source of truth for every pinned tool and ratchet. Sourced by ./mk.
# `./mk setup` installs exactly these; every gate refuses a missing or
# mismatched tool, so local and CI cannot drift. Renovate proposes bumps
# (see renovate.json), except for RUST_NIGHTLY, which is bumped by hand.

# Nightly is only used for miri (nightly tier).
RUST_NIGHTLY="nightly-2026-11-03"

# crate@version, installed with cargo-binstall (prebuilt where available).
CARGO_TOOLS_CI=(typos-cli@1.52.0 cargo-deny@0.20.2 cargo-audit@0.22.2 cargo-machete@0.9.2 cargo-nextest@0.9.151 cargo-semver-checks@0.51.0 echoes@0.12.0 refquiem@0.3.5 zizmor@1.32.0 cargo-mutants@27.1.0 cargo-hack@0.6.46)
CARGO_TOOLS_NIGHTLY=(cargo-llvm-cov@0.9.1 cargo-outdated@0.19.0)

# Not on crates.io; installed from their GitHub releases.
# renovate: github-releases tombi-toml/tombi
TOMBI_VERSION="1.9.9"
# renovate: github-releases koalaman/shellcheck
SHELLCHECK_VERSION="0.11.0"
